// xkeen-template: {"title":"Observatory (leastPing)","description":"Минимальный observatory для balancer.strategy.type=leastPing (по статье jameszero 4025)."}
//
// Примечания:
// - subjectSelector может содержать теги outbounds или префиксы (например "proxy").
// - probeUrl — быстрый URL для проверки доступности/задержки (generate_204 обычно отвечает сразу).
// - probeInterval — интервал опроса.
// - enableConcurrency=true полезно при нескольких прокси, чтобы проверять параллельно.

{
  "observatory": {
    "subjectSelector": ["proxy"],
    "probeUrl": "https://www.google.com/generate_204",
    "probeInterval": "60s",
    "enableConcurrency": true
  }
}

// Для balancer.strategy.type=leastLoad нужна burstObservatory: только она считает
// разброс задержки и долю неудачных проб. Не включайте одновременно с observatory —
// ядро возьмёт обычную, и leastLoad останется без этих данных.
// {
//   "burstObservatory": {
//     "subjectSelector": ["proxy"],
//     "pingConfig": {
//       "destination": "https://www.google.com/generate_204",
//       "interval": "2m",
//       "sampling": 3,
//       "timeout": "5s"
//     }
//   }
// }
