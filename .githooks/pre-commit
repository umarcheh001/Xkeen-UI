#!/bin/sh
# Перед коммитом сверяет сгенерированные описи (опись модулей, размеры модулей,
# опись иконок и другие слепки) с тем, что уходит в коммит. Устаревшая опись
# раньше всплывала только красным CI после пуша.
#
# Включить один раз:  git config core.hooksPath .githooks
# Пропустить разово:  XKEEN_SKIP_INVENTORY_CHECK=1 git commit ...

[ "${XKEEN_SKIP_INVENTORY_CHECK:-}" = "1" ] && exit 0

# $0 — путь к pre-commit: git передаёт его с «/», в тестах на Windows бывает «\».
case $0 in
  */*) hooks_dir=${0%/*} ;;
  *\\*) hooks_dir=${0%\\*} ;;
  *) hooks_dir=. ;;
esac
script="$hooks_dir/../scripts/refresh_inventory.py"
[ -f "$script" ] || exit 0

py=""
for candidate in python3 python; do
  # --version отсеивает заглушку Microsoft Store, которая есть в PATH, но не запускается.
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" --version >/dev/null 2>&1; then
    py=$candidate
    break
  fi
done
if [ -z "$py" ]; then
  echo "[проверка описей] пропущено: не найден Python"
  exit 0
fi

exec "$py" "$script" --check
